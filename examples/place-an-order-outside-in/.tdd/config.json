{
  "defaultMode": "outside-in",
  "testCommand": "mvn -q test",
  "acceptanceCommand": "mvn -q test -Pacceptance",
  "testFilePatterns": ["src/test/**"],
  "acceptanceTestPatterns": ["src/test/java/shop/acceptance/**"],
  "fakePatterns": ["src/test/java/shop/fakes/**"],
  "testSupportPatterns": ["src/test/java/shop/builders/**", "src/test/java/shop/assertions/**", "src/test/java/shop/contracts/**"],
  "assertionMethodPatterns": ["\\.(isShipped\\w*|costsShipping)\\("],
  "sourceFilePatterns": ["src/main/**"],
  "freeFilePatterns": ["*.md", ".tdd/test-list.md"],
  "mockPolicy": { "inside-out": "allow", "outside-in": "justify" },
  "mutationCommand": "mvn -q org.pitest:pitest-maven:mutationCoverage",
  "commitOnGreen": false,
  "commitOnRefactor": false,
  "strict": true
}
